# Copy to .env and adjust. Never commit .env.
# development: a missing/placeholder JWT_SECRET is replaced by a random per-process secret (with a warning)
# production:  the server refuses to start without a real secret
ENV=development
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=nutrisnap
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
MAX_UPLOAD_MB=8
ONNX_THREADS=2
# optional overrides
# MODEL_DIR=./models
# ARTIFACTS_DIR=./artifacts
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=300
